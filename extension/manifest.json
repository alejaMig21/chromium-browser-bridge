{
  "manifest_version": 3,
  "name": "Local Browser Bridge",
  "version": "1.0.0",
  "description": "Lets the local browser-cdp MCP server drive the tab you are looking at through chrome.debugger. Talks only to 127.0.0.1; no account, no network.",
  "key": "",
  "permissions": ["debugger", "tabs", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js" }
}
